{
  "schemaVersion": 1,
  "service": {
    "id": "calculos-ritmo-jc",
    "displayName": "Calculos Ritmo JC",
    "description": "Runs the Calculos Ritmo JC Spring Boot application as a Windows service.",
    "startMode": "automaticDelayedStart"
  },
  "java": {
    "executablePath": "C:\\Program Files\\Eclipse Adoptium\\jdk-25.0.4.7-hotspot\\bin\\java.exe",
    "jvmArguments": [
      "-Xms256m",
      "-Xmx1024m",
      "-XX:+ExitOnOutOfMemoryError"
    ]
  },
  "application": {
    "jarPath": "C:\\projects\\calculos-ritmo-jc\\target\\ritm-0.0.1-SNAPSHOT.jar",
    "workingDirectory": "C:\\projects\\calculos-ritmo-jc\\target",
    "arguments": [
      "--spring.profiles.active=prod",
      "--server.address=192.168.1.98",
      "--server.port=8080"
    ],
    "environmentVariables": {}
  },
  "timeouts": {
    "startupSeconds": 120,
    "shutdownSeconds": 30,
    "forceKillAfterShutdownTimeout": true
  },
  "restart": {
    "policy": "onFailure",
    "maximumAttempts": 5,
    "resetAfterMinutes": 30,
    "initialDelaySeconds": 10,
    "maximumDelaySeconds": 300
  },
  "healthCheck": {
    "enabled": true,
    "type": "httpJson",
    "url": "http://192.168.1.98:8080/api/heartbeat/java/",
    "intervalSeconds": 30,
    "timeoutSeconds": 5,
    "failureThreshold": 3,
    "expectedStatusCode": 200,
    "expectedJsonProperty": "res.status",
    "expectedJsonValue": "UP"
  },
  "logs": {
    "directory": "C:\\ProgramData\\suzdalenko-dev\\Windows JAR Service Manager\\logs\\calculos-ritmo-jc",
    "maximumFileSizeMegabytes": 20,
    "retainedFileCount": 10
  }
}